# Generated by debaser's release pipeline for a stable release; pre-releases
# never reach the AUR. This package repackages the release binary, no build.
pkgname=debaser-bin
pkgver={{version}}
pkgrel=1
pkgdesc="{{summary}}"
arch=('x86_64' 'aarch64')
url="{{homepage}}"
license=('{{license}}')
depends=('git>=2.38')
provides=('debaser')
conflicts=('debaser')
# The release binary is already compiled and checksum-verified; stripping it
# would change the packaged file and its reported version (FR-015).
options=('!strip' '!debug')
source_x86_64=("{{base_url}}/{{asset_linux_amd64}}")
source_aarch64=("{{base_url}}/{{asset_linux_arm64}}")
sha256sums_x86_64=('{{sha256_linux_amd64}}')
sha256sums_aarch64=('{{sha256_linux_arm64}}')

package() {
  # `source` holds this architecture's entry, so the asset name comes from it.
  install -Dm755 "${srcdir}/$(basename "${source[0]}")" "${pkgdir}/usr/bin/debaser"
}
